<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Urbanfix" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#42A5F5</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowBackground">#121212</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">#E2E3DE</item>

        <item name="colorSurfaceVariant">#1E1E1E</item>
        <item name="colorOnSurfaceVariant">#A0A0A0</item>

        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Urbanfix" parent="Base.Theme.Urbanfix" />

    <style name="Theme.Urbanfix.Small" parent="Theme.Urbanfix">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.Urbanfix.Medium" parent="Theme.Urbanfix">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Urbanfix.Large" parent="Theme.Urbanfix">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Theme.Urbanfix.Sans" parent="Theme.Urbanfix">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Urbanfix.Serif" parent="Theme.Urbanfix">
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="Theme.Urbanfix.Mono" parent="Theme.Urbanfix">
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ToolbarInlineTitleFont" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="fontFamily">@font/bricolage_bold</item>
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">44sp</item>
    </style>
</resources>